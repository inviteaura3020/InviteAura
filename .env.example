# Frontend (safe to expose in browser; use Supabase Publishable/anon key only)
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY

# Server-only values for the RSVP email API (NEVER prefix these with VITE_)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=InviteAura <noreply@your-verified-domain.com>
INVITEAURA_NOTIFY_EMAIL=you@example.com
